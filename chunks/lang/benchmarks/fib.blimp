# Fibonacci benchmark - fib(25)
# Uses closures with simple guard logic

fib = fn(n) do
  situation n do
    :zero -> 0
    _ -> fib(n - 1) + fib(n - 2)
  end
end

# Map 0 and 1 to :zero, everything else stays as integer
fib_wrapper = fn(n) do
  situation n do
    0 -> 0
    1 -> 1
    _ -> fib_wrapper(n - 1) + fib_wrapper(n - 2)
  end
end
