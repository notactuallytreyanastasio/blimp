# A key-value store with get, put, delete, and bulk operations
actor KVStore do
  state data: %{String => Any} :: %{}
  state version: Int :: 0

  on :get(key: String) -> Any do
    reply lookup(data, key)
  end

  on :put(key: String, value: Any) -> {Atom, Int} do
    become data: insert(data, key, value),
           version: version + 1
    reply {:ok, version + 1}
  end

  on :delete(key: String) -> Atom do
    become data: remove(data, key),
           version: version + 1
    reply :ok
  end

  on :keys -> [String] do
    reply keys(data)
  end

  on :size -> Int do
    reply length(keys(data))
  end

  on :version -> Int do
    reply version
  end
end
