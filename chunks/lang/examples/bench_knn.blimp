# K-nearest neighbors benchmark -- distance computation
# Brute-force KNN: compute manhattan distances over an NxN grid

def abs_val(x: Int) do
  situation x do
    n when n >= 0 -> n
    _ -> 0 - x
  end
end

def manhattan(x1: Int, y1: Int, x2: Int, y2: Int) do
  abs_val(x1 - x2) + abs_val(y1 - y2)
end

# Compute sum of distances from query point to all points in an NxN grid
# This is O(N^2) distance calculations -- the hot loop of any KNN
def grid_distances(n: Int, qx: Int, qy: Int) do
  situation n do
    0 -> 0
    _ ->
      row_sum = grid_row(n, n, qx, qy)
      row_sum + grid_distances(n - 1, qx, qy)
  end
end

def grid_row(y: Int, cols: Int, qx: Int, qy: Int) do
  situation cols do
    0 -> 0
    _ ->
      d = manhattan(cols, y, qx, qy)
      d + grid_row(y, cols - 1, qx, qy)
  end
end

# 500x500 grid = 250,000 distance calculations
grid_distances(1000, 500, 500)
