# A checkout actor with state and pattern matching
actor Checkout do
  state items: [Item] :: []
  state total: Int :: 0

  on :add(item: Item) -> Atom do
    become items: [item | items],
           total: total + item.price
    reply :ok
  end

  on :summary -> {[Item], Int} do
    reply {items, total}
  end

  on :clear -> Atom do
    become items: [], total: 0
    reply :cleared
  end
end
