# SKETCH, NOT A PROGRAM. `blimp examples/checkout.blimp` stops with
#   Parse error: error.UnexpectedToken
# at the first leading `|>` in :charge.
# It was written on 2026-03-20, the day the grammar was, and uses syntax
# the parser does not accept: a pipe chain continued on the next line
# with a leading `|>`, and `expr orelse bubble` (D7 in
# docs/lang_design/parser.md). The types Item and Payment and the
# functions valid?, calculate_tax, finalize, validate and retry_payment
# are defined nowhere, and nothing runs at the top level. For a shop that
# runs, see shop_system.blimp and dot_notation.blimp.
# scripts/run_examples.sh lists it as expected to fail; if it starts to
# parse, that suite says so.
#
# A full checkout actor showing typed state, guards, pipes, bubbles, and holes
actor Shop do
  state region: Atom :: :us
end

actor Shop.Checkout do
  state items: [Item] :: []
  state total: Float :: 0.0

  on :add(item: Item) do
    become items: [item | items],
           total: total + item.price
    reply length(items)
  end

  on :charge(payment: Payment)
      when valid?(payment)
      bubbles(CascadeBubble) do
    receipt = items
      |> calculate_tax(_, region)
      |> finalize(_, payment)
    become items: [], total: 0.0
    reply receipt
  end

  on :charge(payment: Payment)
      bubbles(CascadeBubble) do
    situation validate(payment) do
      :recoverable ->
        retry_payment(payment) orelse bubble
      _ # Hole: handle unrecoverable payment failure,
        # research PCI compliance for error responses
    end
  end

  on :summary -> {[Item], Int} do
    reply {items, total}
  end

  on :clear do
    become items: [], total: 0.0
    reply :cleared
  end
end

actor Shop.Inventory do
  state stock: %{String => Int} :: %{}

  on :check(item_name: String) do
    reply lookup(stock, item_name)
  end

  on :restock(item_name: String, quantity: Int) when quantity > 0 do
    current = lookup(stock, item_name) orelse 0
    become stock: put(stock, item_name, current + quantity)
    reply :ok
  end
end
