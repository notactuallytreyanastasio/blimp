# A data processing pipeline actor
# Collects items, transforms them, emits batches
actor Pipeline do
  state buffer: [Item] :: []
  state batch_size: Int :: 10
  state processed: Int :: 0

  on :push(item: Item) -> {Atom, Int} do
    new_buffer = [item | buffer]
    become buffer: new_buffer,
           processed: processed + 1
    reply {:buffered, length(new_buffer)}
  end

  on :flush -> {Atom, [Item]} do
    result = buffer
    become buffer: []
    reply {:flushed, result}
  end

  on :stats -> %{Atom => Int} do
    reply %{buffered: length(buffer), total_processed: processed, batch_size: batch_size}
  end

  on :configure(new_batch_size: Int) -> {Atom, Int} do
    become batch_size: new_batch_size
    reply {:ok, new_batch_size}
  end

  on :reset -> Atom do
    become buffer: [], processed: 0
    reply :reset
  end
end
