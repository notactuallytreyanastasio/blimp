# Marketplace Simulation - simplified for REPL compatibility

actor Account do
  state balance: Int :: 0
  state owner: String :: "unknown"
  state tx: Int :: 0
  on :deposit(amount) when amount > 0 do
    become balance: balance + amount, tx: tx + 1
    reply balance + amount
  end
  on :withdraw(amount) when amount > 0 do
    situation balance - amount do
      n when n >= 0 ->
        become balance: n, tx: tx + 1
        reply n
      _ -> bubble :insufficient_funds
    end
  end
  on :balance do
    reply balance
  end
  on :info do
    reply %{owner: owner, balance: balance, tx: tx}
  end
end

actor Thief do
  state stolen: Int :: 0
  state attempts: Int :: 0
  on :steal(account, amount) do
    become attempts: attempts + 1
    result = account <- :withdraw(amount) orelse :blocked
    situation result do
      :blocked -> reply :blocked
      _ ->
        become stolen: stolen + amount
        reply :stolen
    end
  end
  on :report do
    reply %{stolen: stolen, attempts: attempts}
  end
end

# Set up
alice = %Account{balance: 500, owner: "alice"}
bob = %Account{balance: 300, owner: "bob"}
thief = spawn Thief

# Round 1: Alice buys stuff
alice <- :withdraw(25)
alice <- :withdraw(10)
alice <- :withdraw(50)

# Round 2: Bob buys stuff
bob <- :withdraw(15)
bob <- :withdraw(30)

# Round 3: Thief strikes
thief <- :steal(alice, 100)
thief <- :steal(bob, 500)

# Round 4: More activity
alice <- :deposit(200)
alice <- :withdraw(75)
bob <- :deposit(100)

# Round 5: Thief again
thief <- :steal(alice, 50)
thief <- :steal(bob, 25)

# Final report
alice <- :info
bob <- :info
thief <- :report
