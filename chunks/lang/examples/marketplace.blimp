# Marketplace Simulation
#
# Hierarchy:
#   Marketplace
#     Marketplace.AccountHolder          (person)
#       Marketplace.AccountHolder.Account   (their bank account)
#       Marketplace.AccountHolder.Wallet    (their cash on hand)
#     Marketplace.Institution            (business)
#       Marketplace.Institution.Account     (business bank account)
#     Marketplace.Thief                  (villain)

# ── The world ──

actor Marketplace do
  state name: String :: "bazaar"
  state epoch: Int :: 0
  on :tick -> Int do
    become epoch: epoch + 1
    reply epoch
  end
  on :epoch -> Int do
    reply epoch
  end
end

# ── Bank account: supervised by whoever owns it ──

actor Marketplace.AccountHolder.Account do
  state balance: Int :: 0
  state owner: String :: "unknown"
  state tx: Int :: 0
  on :deposit(amount: Int) when amount > 0 do
    become balance: balance + amount, tx: tx + 1
    reply balance + amount
  end
  on :withdraw(amount: Int) when amount > 0 do
    situation balance - amount do
      n when n >= 0 ->
        become balance: n, tx: tx + 1
        reply n
      _ -> bubble :insufficient_funds
    end
  end
  on :balance -> Int do
    reply balance
  end
  on :info do
    reply %{owner: owner, balance: balance, tx: tx}
  end
end

# ── Wallet: cash on hand, supervised by the account holder ──

actor Marketplace.AccountHolder.Wallet do
  state cash: Int :: 0
  state owner: String :: "unknown"
  on :add(amount: Int) when amount > 0 do
    become cash: cash + amount
    reply cash + amount
  end
  on :take(amount: Int) when amount > 0 do
    situation cash - amount do
      n when n >= 0 ->
        become cash: n
        reply n
      _ -> bubble :empty_wallet
    end
  end
  on :cash -> Int do
    reply cash
  end
end

# ── AccountHolder: owns an account and a wallet ──

actor Marketplace.AccountHolder do
  state name: String :: "unknown"
  state account: Int :: 0
  state wallet: Int :: 0
  state total_spent: Int :: 0

  # Pay from wallet first, fall back to account
  on :buy(amount: Int) when amount > 0 do
    wallet_result = wallet <- :take(amount) orelse :short
    situation wallet_result do
      :short ->
        account <- :withdraw(amount)
        become total_spent: total_spent + amount
        reply :from_account
      _ ->
        become total_spent: total_spent + amount
        reply :from_wallet
    end
  end

  # Deposit goes to account
  on :deposit(amount: Int) when amount > 0 do
    account <- :deposit(amount)
    reply :ok
  end

  # Withdraw cash from account into wallet
  on :withdraw_cash(amount: Int) when amount > 0 do
    result = account <- :withdraw(amount) orelse :blocked
    situation result do
      :blocked -> reply :blocked
      _ ->
        wallet <- :add(amount)
        reply :ok
    end
  end

  on :status do
    acct_bal = account <- :balance
    wallet_cash = wallet <- :cash
    reply %{name: name, account: acct_bal, wallet: wallet_cash, spent: total_spent}
  end
end

# ── Institution account: supervised by the institution ──

actor Marketplace.Institution.Account do
  state balance: Int :: 0
  state owner: String :: "unknown"
  state tx: Int :: 0
  on :deposit(amount: Int) when amount > 0 do
    become balance: balance + amount, tx: tx + 1
    reply balance + amount
  end
  on :withdraw(amount: Int) when amount > 0 do
    situation balance - amount do
      n when n >= 0 ->
        become balance: n, tx: tx + 1
        reply n
      _ -> bubble :insufficient_funds
    end
  end
  on :balance -> Int do
    reply balance
  end
end

# ── Institution: a business that owns an account ──

actor Marketplace.Institution do
  state name: String :: "unknown"
  state account: Int :: 0
  state revenue: Int :: 0

  on :charge(customer: Int, amount: Int) when amount > 0 do
    customer <- :buy(amount)
    account <- :deposit(amount)
    become revenue: revenue + amount
    reply :charged
  end

  on :pay_supplier(supplier: Int, amount: Int) when amount > 0 do
    result = account <- :withdraw(amount) orelse :broke
    situation result do
      :broke -> reply :broke
      _ ->
        supplier <- :deposit(amount)
        reply :paid
    end
  end

  on :revenue -> Int do
    reply revenue
  end

  on :status do
    bal = account <- :balance
    reply %{name: name, balance: bal, revenue: revenue}
  end
end

# ── Thief: targets wallets (easy) and accounts (hard) ──

actor Marketplace.Thief do
  state stolen: Int :: 0
  state attempts: Int :: 0
  state blocked: Int :: 0

  on :pickpocket(wallet: Int, amount: Int) do
    become attempts: attempts + 1
    result = wallet <- :take(amount) orelse :missed
    situation result do
      :missed ->
        become blocked: blocked + 1
        reply :missed
      _ ->
        become stolen: stolen + amount
        reply :got_it
    end
  end

  on :hack(account: Int, amount: Int) do
    become attempts: attempts + 1
    result = account <- :withdraw(amount) orelse :blocked
    situation result do
      :blocked ->
        become blocked: blocked + 1
        reply :blocked
      _ ->
        become stolen: stolen + amount
        reply :hacked
    end
  end

  on :report do
    reply %{stolen: stolen, attempts: attempts, blocked: blocked}
  end
end

# ══════════════════════════════════════════════════════════
# The simulation
# ══════════════════════════════════════════════════════════

# Boot the world
market = spawn Marketplace

# People -- account and wallet are children of the account holder
alice_acct = %Marketplace.AccountHolder.Account{balance: 1000, owner: "alice"}
alice_wallet = %Marketplace.AccountHolder.Wallet{cash: 200, owner: "alice"}
alice = %Marketplace.AccountHolder{name: "alice", account: alice_acct, wallet: alice_wallet}

bob_acct = %Marketplace.AccountHolder.Account{balance: 500, owner: "bob"}
bob_wallet = %Marketplace.AccountHolder.Wallet{cash: 50, owner: "bob"}
bob = %Marketplace.AccountHolder{name: "bob", account: bob_acct, wallet: bob_wallet}

# Businesses -- account is a child of the institution
shop_acct = %Marketplace.Institution.Account{balance: 5000, owner: "shop"}
shop = %Marketplace.Institution{name: "shop", account: shop_acct}

cafe_acct = %Marketplace.Institution.Account{balance: 2000, owner: "cafe"}
cafe = %Marketplace.Institution{name: "cafe", account: cafe_acct}

# The thief
thief = spawn Marketplace.Thief

# ── Day 1: Normal commerce ──
market <- :tick

shop <- :charge(alice, 50)
cafe <- :charge(alice, 15)
shop <- :charge(bob, 30)
cafe <- :charge(bob, 8)

# ── Day 2: Cash withdrawals ──
market <- :tick

alice <- :withdraw_cash(100)
bob <- :withdraw_cash(50)

shop <- :charge(alice, 25)
cafe <- :charge(bob, 12)

# ── Day 3: The thief strikes ──
market <- :tick

thief <- :pickpocket(alice_wallet, 75)
thief <- :pickpocket(bob_wallet, 100)
thief <- :hack(alice_acct, 500)
thief <- :hack(bob_acct, 1000)

# ── Day 4: Business pays supplier ──
market <- :tick

shop <- :pay_supplier(cafe, 200)
shop <- :charge(alice, 40)
cafe <- :charge(bob, 20)

# ── Day 5: Thief tries again ──
market <- :tick

thief <- :pickpocket(alice_wallet, 50)
thief <- :pickpocket(bob_wallet, 30)
thief <- :hack(shop_acct, 2000)

# ── Final report ──

market <- :epoch
alice <- :status
bob <- :status
shop <- :status
cafe <- :status
thief <- :report
