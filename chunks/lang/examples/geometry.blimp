actor Point do
  state x: Int :: 0
  state y: Int :: 0

  on :move(dx: Int, dy: Int) do
    become x: x + dx, y: y + dy
    reply x + dx + y + dy
  end
end

p = spawn Point, x: 3, y: 4
# State is private to the actor: the answer is :move's reply, 37, not a
# read of p.x from outside.
p <- :move(10, 20)
