# Error: Bubble caught by try/catch
# Shows: Error reason passed through to catch variable

actor Validator do
  state strict: Bool :: true
  on :check(input) do
    situation input do
      :valid -> reply :ok
      _ -> bubble :invalid_input
    end
  end
end

v = spawn Validator

# Happy path
v <- :check(:valid)

# Bubble path caught by try/catch
try do
  v <- :check(:bad)
catch err do
  "caught: #{err}"
end
