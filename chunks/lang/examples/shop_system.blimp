# A shop system demonstrating dot-notation actors, guards, and bubbles
# Dot-notation groups related actors into namespaces

actor Shop.Inventory do
  state items: [Item] :: []
  state restock_threshold: Int :: 5

  on :add(item: Item) -> Atom do
    become items: [item | items]
    reply :ok
  end

  on :remove(item: Item) -> {Atom, Item} when length(items) > 0 do
    become items: remove(items, item)
    reply {:ok, item}
  end

  on :count -> Int do
    reply length(items)
  end
end

actor Shop.Checkout do
  state cart: [Item] :: []
  state total: Int :: 0
  state discount: Int :: 0

  on :add_item(item: Item) -> {Atom, Item} do
    become cart: [item | cart],
           total: total + item.price
    reply {:added, item}
  end

  on :apply_discount(percent: Int) -> {Atom, Int} when percent > 0 do
    become discount: percent
    reply {:discount, percent}
  end

  on :charge(payment: Payment) -> {Atom, Int} when payment.amount >= total bubbles(CascadeBubble) do
    reply {:charged, total}
  end

  on :refund(payment: Payment) -> {Atom, Int} when valid?(payment) bubbles(CascadeBubble) do
    reply {:refunded, payment.amount}
  end

  on :summary -> %{Atom => Any} do
    reply %{items: cart, total: total, discount: discount}
  end
end

actor Shop.Analytics do
  state events: [Event] :: []
  state total_revenue: Int :: 0

  on :record(event: Event) -> Atom bubbles(CascadeBubble) do
    become events: [event | events]
    reply :ok
  end

  on :revenue -> Int do
    reply total_revenue
  end
end
