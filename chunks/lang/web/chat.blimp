# Blimp Chat -- first real web app
# Run: ./blimp web/chat.blimp
# Open: http://localhost:8080

# ── Chat Room actor ──────────────────────────────────
# Holds messages and connected users. Single source of truth.

actor ChatRoom do
  state messages: List :: []
  state users: List :: []
  state next_id: Int :: 1

  on :join(username: String) do
    case list_has(users, username) do
      true -> reply :already_joined
      _ ->
        msg = %{id: next_id, from: "system", text: concat(username, " joined the chat"), ts: now()}
        become users: append(users, username), messages: append(messages, msg), next_id: next_id + 1
        reply :ok
    end
  end

  on :send_msg(from: String, text: String) do
    msg = %{id: next_id, from: from, text: text, ts: now()}
    become messages: append(messages, msg), next_id: next_id + 1
    reply msg
  end

  on :recent(count: Int) do
    total = length(messages)
    start = max(0, total - count)
    reply slice_list(messages, start, total)
  end

  on :get_users do
    reply users
  end

  on :leave(username: String) do
    msg = %{id: next_id, from: "system", text: concat(username, " left the chat"), ts: now()}
    become users: remove_from(users, username), messages: append(messages, msg), next_id: next_id + 1
    reply :ok
  end
end

# ── Helpers ──────────────────────────────────────────

def list_has(items: List, target: String) -> Bool do
  case empty?(items) do
    true -> false
    _ ->
      case head(items) == target do
        true -> true
        _ -> list_has(tail(items), target)
      end
  end
end

def remove_from(items: List, target: String) -> List do
  filter(items, fn(x: String) do x != target end)
end

def slice_list(items: List, start: Int, stop: Int) -> List do
  slice_idx(items, start, stop, start, [])
end

def slice_idx(items: List, start: Int, stop: Int, idx: Int, acc: List) -> List do
  case idx >= stop or idx >= length(items) do
    true -> acc
    _ ->
      item = elem(items, idx)
      slice_idx(items, start, stop, idx + 1, append(acc, item))
  end
end

def max(a: Int, b: Int) -> Int do
  case a >= b do true -> a _ -> b end
end

# ── Sessions ─────────────────────────────────────────

actor Sessions do
  state store: Map :: %{}

  on :get(id: String) do
    reply lookup(store, id)
  end

  on :put(id: String, data: Map) do
    become store: put(store, id, data)
    reply :ok
  end

  on :new_session do
    token = concat(to_string(random(100000, 999999)), concat("-", to_string(now())))
    reply token
  end
end

# ── Cookie parsing ───────────────────────────────────

def find_header(raw: String, header_name: String) -> String do
  lines = split(raw, "\r\n")
  find_header_line(lines, header_name)
end

def find_header_line(lines: List, header_name: String) -> String do
  case empty?(lines) do
    true -> ""
    _ ->
      line = head(lines)
      case contains(line, header_name) do
        true ->
          parts = split(line, ": ")
          case length(parts) >= 2 do
            true -> elem(parts, 1)
            _ -> ""
          end
        _ -> find_header_line(tail(lines), header_name)
      end
  end
end

def parse_cookie(raw: String) -> String do
  cookie_header = find_header(raw, "Cookie")
  case cookie_header == "" do
    true -> ""
    _ -> find_cookie_value(cookie_header, "blimp_session=")
  end
end

def find_cookie_value(cookie_str: String, prefix: String) -> String do
  pairs = split(cookie_str, "; ")
  find_in_pairs(pairs, prefix)
end

def find_in_pairs(pairs: List, prefix: String) -> String do
  case empty?(pairs) do
    true -> ""
    _ ->
      pair = head(pairs)
      case contains(pair, prefix) do
        true ->
          parts = split(pair, "=")
          case length(parts) >= 2 do
            true -> elem(parts, 1)
            _ -> ""
          end
        _ -> find_in_pairs(tail(pairs), prefix)
      end
  end
end

# ── URL decode ───────────────────────────────────────

def url_decode(s: String) -> String do
  parts = split(s, "+")
  join_parts(parts, " ")
end

def join_parts(parts: List, sep: String) -> String do
  case empty?(parts) do
    true -> ""
    _ ->
      case empty?(tail(parts)) do
        true -> head(parts)
        _ -> concat(head(parts), concat(sep, join_parts(tail(parts), sep)))
      end
  end
end

# ── Form parsing ─────────────────────────────────────

def parse_form(body: String) -> Map do
  pairs = split(body, "&")
  parse_pairs(pairs, %{})
end

def parse_pairs(pairs: List, acc: Map) -> Map do
  case empty?(pairs) do
    true -> acc
    _ ->
      pair = head(pairs)
      kv = split(pair, "=")
      case length(kv) >= 2 do
        true ->
          key = head(kv)
          val = url_decode(elem(kv, 1))
          parse_pairs(tail(pairs), put(acc, key, val))
        _ -> parse_pairs(tail(pairs), acc)
      end
  end
end

# ── Rendering ────────────────────────────────────────

def render_login() -> String do
  concat(html_page("Blimp Chat - Login", concat(
    "<div class='login-box'>",
    concat("<h1>blimp chat</h1>",
    concat("<form method='POST' action='/login'>",
    concat("<input type='text' name='username' placeholder='Pick a username' autofocus>",
    concat("<button type='submit'>Join</button>",
    "</form></div>"))))
  )), "")
end

def render_chat(username: String, room: Any) do
  messages = room <- :recent(50)
  users = room <- :get_users
  msg_html = render_messages(messages)
  user_html = render_users(users)
  sidebar = concat("<div class='sidebar'><h2>Online</h2><div class='user-list'>", concat(user_html, "</div></div>"))
  input_form = concat("<form class='chat-input' method='POST' action='/send'><input type='hidden' name='from' value='", concat(username, "'><input type='text' name='text' placeholder='Type a message...' autofocus autocomplete='off'><button type='submit'>Send</button></form>"))
  main_area = concat("<div class='chat-main'><div class='messages' id='messages'>", concat(msg_html, concat("</div>", concat(input_form, "</div>"))))
  body = concat("<div class='chat-layout'>", concat(sidebar, concat(main_area, "</div>")))
  html_page("Blimp Chat", body)
end

def render_messages(messages: List) -> String do
  case empty?(messages) do
    true -> ""
    _ ->
      msg = head(messages)
      rest = render_messages(tail(messages))
      from_name = lookup(msg, "from") orelse "unknown"
      msg_text = lookup(msg, "text") orelse ""
      cls = case from_name == "system" do
        true -> "msg system"
        _ -> "msg"
      end
      line = concat("<div class='", concat(cls, concat("'><span class='from'>", concat(to_string(from_name), concat("</span> ", concat(to_string(msg_text), "</div>"))))))
      concat(line, rest)
  end
end

def render_users(users: List) -> String do
  case empty?(users) do
    true -> ""
    _ ->
      concat("<div class='user'>", concat(head(users), concat("</div>", render_users(tail(users)))))
  end
end

# ── Page template ────────────────────────────────────

def html_page(title: String, body: String) -> String do
  concat("<!DOCTYPE html><html><head><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>",
    concat(title, concat("</title>", concat(chat_styles(), concat("</head><body>", concat(body, concat(chat_script(), "</body></html>")))))))
end

def chat_styles() do
  "<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'SF Mono', Menlo, monospace; background: #0e0e1a; color: #d4d4d4; height: 100vh; }
    .login-box { max-width: 400px; margin: 20vh auto; padding: 2rem; text-align: center; }
    .login-box h1 { color: #a855f7; margin-bottom: 1.5rem; }
    .login-box form { display: flex; gap: 0.5rem; }
    .login-box input { flex: 1; padding: 0.75rem; background: #1a1a2e; border: 1px solid #2a2a4e; border-radius: 6px; color: #d4d4d4; font: inherit; font-size: 16px; }
    .login-box button { padding: 0.75rem 1.5rem; background: #a855f7; color: white; border: none; border-radius: 6px; font: inherit; cursor: pointer; }
    .chat-layout { display: flex; height: 100vh; }
    .sidebar { width: 200px; background: #12122a; border-right: 1px solid #2a2a4e; padding: 1rem; flex-shrink: 0; }
    .sidebar h2 { color: #a855f7; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem; }
    .user { padding: 0.3rem 0; font-size: 0.85rem; color: #a6e22e; }
    .chat-main { flex: 1; display: flex; flex-direction: column; }
    .messages { flex: 1; overflow-y: auto; padding: 1rem; }
    .msg { padding: 0.3rem 0; font-size: 0.9rem; }
    .msg .from { color: #a855f7; font-weight: 600; }
    .msg.system { color: #666; font-style: italic; font-size: 0.8rem; }
    .msg.system .from { color: #666; }
    .chat-input { display: flex; gap: 0.5rem; padding: 0.75rem 1rem; border-top: 1px solid #2a2a4e; background: #12122a; }
    .chat-input input[type=text] { flex: 1; padding: 0.6rem; background: #1a1a2e; border: 1px solid #2a2a4e; border-radius: 6px; color: #d4d4d4; font: inherit; font-size: 14px; }
    .chat-input button { padding: 0.6rem 1.5rem; background: #a855f7; color: white; border: none; border-radius: 6px; font: inherit; cursor: pointer; }
    @media (max-width: 600px) { .sidebar { display: none; } }
  </style>"
end

def chat_script() do
  "<script>
    (function() {
      var ws, rd = 1000;
      function connect() {
        ws = new WebSocket('ws://' + location.host + '/ws');
        ws.onopen = function() { rd = 1000; };
        ws.onmessage = function(e) {
          var data = JSON.parse(e.data);
          if (data.type === 'html') {
            var chat = document.querySelector('.chat-main');
            if (chat) {
              var msgs = chat.querySelector('.messages');
              var form = chat.querySelector('.chat-input');
              var div = document.createElement('div');
              div.innerHTML = data.messages;
              if (msgs) msgs.innerHTML = div.innerHTML;
              // Update user list
              var ul = document.querySelector('.user-list');
              if (ul && data.users) ul.innerHTML = data.users;
              // Scroll to bottom
              if (msgs) msgs.scrollTop = msgs.scrollHeight;
            }
          }
        };
        ws.onclose = function() { setTimeout(connect, rd); rd = Math.min(rd * 2, 10000); };
      }
      connect();

      // Override form submit to send via WS
      var form = document.querySelector('.chat-input');
      if (form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var inp = form.querySelector('input[type=text]');
          var from = form.querySelector('input[name=from]');
          if (ws && ws.readyState === 1 && inp.value) {
            ws.send(JSON.stringify({type:'msg', from: from.value, text: inp.value}));
            inp.value = '';
            inp.focus();
          }
        });
      }

      // Scroll to bottom on load
      var m = document.getElementById('messages');
      if (m) m.scrollTop = m.scrollHeight;
      var inp = document.querySelector('.chat-input input[type=text]');
      if (inp) inp.focus();
    })();
  </script>"
end

# ── HTTP ─────────────────────────────────────────────

def parse_request_line(raw: String) -> Map do
  first_line = head(split(raw, "\r\n"))
  parts = split(first_line, " ")
  %{method: head(parts), path: elem(parts, 1)}
end

def http_ok(body: String) -> String do
  len = to_string(length(body))
  concat("HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: ", concat(len, concat("\r\nConnection: close\r\n\r\n", body)))
end

def http_redirect(location: String) -> String do
  concat("HTTP/1.1 302 Found\r\nLocation: ", concat(location, "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"))
end

def http_ok_with_cookie(body: String, session_id: String) -> String do
  len = to_string(length(body))
  concat("HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: ", concat(len, concat("\r\nSet-Cookie: blimp_session=", concat(session_id, concat("; Path=/; HttpOnly; SameSite=Lax\r\nConnection: close\r\n\r\n", body)))))
end

def http_redirect_with_cookie(location: String, session_id: String) -> String do
  concat("HTTP/1.1 302 Found\r\nLocation: ", concat(location, concat("\r\nSet-Cookie: blimp_session=", concat(session_id, concat("; Path=/; HttpOnly; SameSite=Lax\r\nContent-Length: 0\r\nConnection: close\r\n\r\n", "")))))
end

def get_body(raw: String) -> String do
  parts = split(raw, "\r\n\r\n")
  case length(parts) >= 2 do
    true -> elem(parts, 1)
    _ -> ""
  end
end

# ── Router ───────────────────────────────────────────

def route(method: String, path: String, raw: String, session_id: String, session_data: Map, room: Any, sessions: Any) -> String do
  case path do
    "/" ->
      username = lookup(session_data, "username")
      case nil?(username) do
        true -> http_ok(render_login())
        _ -> http_ok(render_chat(username, room))
      end
    "/login" ->
      case method == "POST" do
        true ->
          body = get_body(raw)
          form = parse_form(body)
          username = lookup(form, "username")
          case nil?(username) or username == "" do
            true -> http_redirect("/")
            _ ->
              
              room <- :join(username)
              
              sess <- :put(session_id, %{username: username})
              http_redirect("/")
          end
        _ -> http_redirect("/")
      end
    "/send" ->
      case method == "POST" do
        true ->
          body = get_body(raw)
          form = parse_form(body)
          from = lookup(form, "from")
          text = lookup(form, "text")
          case nil?(from) or nil?(text) or text == "" do
            true -> http_redirect("/")
            _ ->
              
              room <- :send_msg(from, text)
              http_redirect("/")
          end
        _ -> http_redirect("/")
      end
    "/logout" ->
      username = lookup(session_data, "username")
      case nil?(username) do
        true -> :ok
        _ ->
          
          room <- :leave(username)
      end
      
      sess <- :put(session_id, %{})
      http_redirect("/")
    _ -> http_ok("404 Not Found")
  end
end

# ── Server ───────────────────────────────────────────

actor HTTPServer do
  state port: Int :: 8080
  state fd: Int :: -1
  state room: Any :: nil
  state sess: Any :: nil
  state me: Any :: nil

  on :start(r: Any, s: Any, self_ref: Any) do
    server_fd = tcp_listen(port)
    become fd: server_fd, room: r, sess: s, me: self_ref
    print(concat("Blimp Chat running at http://localhost:", to_string(port)))
    accept_loop(server_fd, r, s)
  end

  on :unused do reply :ok end
end

def is_ws_upgrade(raw: String) -> Bool do
  contains(raw, "Upgrade: websocket") or contains(raw, "Upgrade: WebSocket")
end

def parse_ws_key(raw: String) -> String do
  lines = split(raw, "\r\n")
  find_ws_key(lines)
end

def find_ws_key(lines: List) -> String do
  case empty?(lines) do
    true -> ""
    _ ->
      line = head(lines)
      case contains(line, "Sec-WebSocket-Key") do
        true ->
          parts = split(line, ": ")
          case length(parts) >= 2 do
            true -> elem(parts, 1)
            _ -> ""
          end
        _ -> find_ws_key(tail(lines))
      end
  end
end

def ws_upgrade_response(accept_key: String) -> String do
  concat("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ",
    concat(accept_key, "\r\n\r\n"))
end

def ws_push_state(ws_fd: Int, room: Any) -> Any do
  messages = room <- :recent(50)
  users = room <- :get_users
  msg_html = render_messages(messages)
  user_html = render_users(users)
  json = concat("{\"type\":\"html\",\"messages\":\"", concat(json_escape(msg_html), concat("\",\"users\":\"", concat(json_escape(user_html), "\"}"))))
  ws_write_frame(ws_fd, json)
end

def json_escape(s: String) -> String do
  json_escape_loop(s, 0, "")
end

def json_escape_loop(s: String, idx: Int, acc: String) -> String do
  case idx >= length(s) do
    true -> acc
    _ ->
      ch = char_at(s, idx)
      code = char_code(ch)
      escaped = case code == 34 do
        true -> concat(from_char_code(92), from_char_code(34))
        _ ->
          case code == 10 do
            true -> concat(from_char_code(92), "n")
            _ ->
              case code == 13 do
                true -> concat(from_char_code(92), "r")
                _ ->
                  case code == 92 do
                    true -> concat(from_char_code(92), from_char_code(92))
                    _ -> ch
                  end
              end
          end
      end
      json_escape_loop(s, idx + 1, concat(acc, escaped))
  end
end

def handle_ws_connection(client_fd: Int, raw: String, room: Any) do
  key = parse_ws_key(raw)
  accept = ws_accept_key(key)
  response = ws_upgrade_response(accept)
  tcp_write(client_fd, response)
  # Push initial state
  ws_push_state(client_fd, room)
  # Enter WS loop
  ws_chat_loop(client_fd, room)
end

def ws_chat_loop(ws_fd: Int, room: Any) do
  frame = ws_read_frame(ws_fd)
  case nil?(frame) do
    true -> :disconnected
    _ ->
      # Parse the message
      case contains(frame, "\"type\":\"msg\"") do
        true ->
          from_val = extract_json_field(frame, "from")
          text_val = extract_json_field(frame, "text")
          case nil?(from_val) or nil?(text_val) do
            true -> :skip
            _ -> room <- :send_msg(from_val, text_val)
          end
        _ -> :skip
      end
      # Push updated state to this client
      ws_push_state(ws_fd, room)
      # Continue loop
      ws_chat_loop(ws_fd, room)
  end
end

def extract_json_field(json: String, field: String) -> String do
  # Simple JSON field extraction: find "field":"value"
  marker = concat(concat(from_char_code(34), field), concat(from_char_code(34), ":"))
  case contains(json, marker) do
    true ->
      parts = split(json, marker)
      case length(parts) >= 2 do
        true ->
          after_key = elem(parts, 1)
          # Skip the opening quote
          case char_code(after_key, 0) == 34 do
            true ->
              # Find closing quote
              extract_quoted(after_key, 1, "")
            _ -> nil
          end
        _ -> nil
      end
    _ -> nil
  end
end

def extract_quoted(s: String, idx: Int, acc: String) -> String do
  case idx >= length(s) do
    true -> acc
    _ ->
      code = char_code(s, idx)
      case code == 34 do
        true -> acc
        _ ->
          case code == 92 do
            true -> extract_quoted(s, idx + 2, concat(acc, char_at(s, idx + 1)))
            _ -> extract_quoted(s, idx + 1, concat(acc, char_at(s, idx)))
          end
      end
  end
end

def accept_loop(fd: Int, room: Any, sess: Any) do
    client_fd = tcp_accept(fd)
    raw = tcp_read(client_fd)

    case is_ws_upgrade(raw) do
      true ->
        handle_ws_connection(client_fd, raw, room)
      _ ->
        handle_http(client_fd, raw, room, sess)
    end

    accept_loop(fd, room, sess)
end

def handle_http(client_fd: Int, raw: String, room: Any, sess: Any) do
    req = parse_request_line(raw)
    method = lookup(req, "method")
    path = lookup(req, "path")

    # Session handling
    cookie_session = parse_cookie(raw)
    session_id = case cookie_session == "" do
      true -> sess <- :new_session
      _ -> cookie_session
    end
    is_new = cookie_session == ""

    session_data = sess <- :get(session_id)
    session_data = session_data orelse %{}

    case is_new do
      true -> sess <- :put(session_id, session_data)
      _ -> :ok
    end

    response = route(method, path, raw, session_id, session_data, room, sess)

    # Add cookie on new sessions
    final_response = case is_new do
      true ->
        case contains(response, "302 Found") do
          true -> http_redirect_with_cookie("/", session_id)
          _ -> http_ok_with_cookie(response, session_id)
        end
      _ -> response
    end

    tcp_write(client_fd, final_response)
    tcp_close(client_fd)
end

# Boot
chat_room = spawn ChatRoom
chat_sessions = spawn Sessions
http = spawn HTTPServer
http <- :start(chat_room, chat_sessions, http)
