# Blimp HTTP Server
#
# A minimal HTTP/1.1 server written in Blimp.
# Boot:  blimp web/server.blimp
# Then:  open http://localhost:8080

# -- HTTP helpers -----------------------------------------------------

# Parse first line of HTTP request: "GET /path HTTP/1.1"
# Returns %{method: "GET", path: "/"}
def parse_request_line(raw) do
  parts = split(raw, " ")
  method = head(parts)
  path_part = head(tail(parts))
  path = split(path_part, "?") |> head
  %{method: method, path: path}
end

# Build an HTTP 200 response with HTML body
def http_ok(body) do
  len = length(body)
  concat(
    "HTTP/1.1 200 OK\r\n",
    concat("Content-Type: text/html; charset=utf-8\r\n",
    concat("Content-Length: ", concat(to_string(len),
    concat("\r\nConnection: close\r\n\r\n", body))))
  )
end

# Build an HTTP 200 response with Set-Cookie header
def http_ok_with_cookie(body, session_id) do
  len = length(body)
  cookie = concat("Set-Cookie: blimp_session=", concat(session_id,
    "; Path=/; HttpOnly; SameSite=Lax\r\n"))
  concat(
    "HTTP/1.1 200 OK\r\n",
    concat("Content-Type: text/html; charset=utf-8\r\n",
    concat(cookie,
    concat("Content-Length: ", concat(to_string(len),
    concat("\r\nConnection: close\r\n\r\n", body)))))
  )
end

# Build an HTTP 302 redirect
def http_redirect(location) do
  concat(
    "HTTP/1.1 302 Found\r\n",
    concat("Location: ", concat(location,
    "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"))
  )
end

# Build an HTTP 302 redirect with Set-Cookie header
def http_redirect_with_cookie(location, session_id) do
  cookie = concat("Set-Cookie: blimp_session=", concat(session_id,
    "; Path=/; HttpOnly; SameSite=Lax\r\n"))
  concat(
    "HTTP/1.1 302 Found\r\n",
    concat("Location: ", concat(location,
    concat("\r\n", concat(cookie,
    "Content-Length: 0\r\nConnection: close\r\n\r\n"))))
  )
end

# Wrap rendered view in a full HTML page
def html_page(title, body_html) do
  concat(
    "<!DOCTYPE html><html><head><meta charset=utf-8>",
    concat("<title>", concat(title, concat("</title>",
    concat(html_styles(), concat("</head><body>",
    concat(body_html, concat(blimp_script(), "</body></html>")))))))
  )
end

def html_styles() do
  "<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: rgb(249,249,249); color: rgb(17,17,17); }
    div { display: flex; flex-direction: column; gap: 8px; padding: 8px; }
    div[data-row] { flex-direction: row; }
    h1,h2,h3,h4,h5,h6 { margin: 8px 0; }
    button { padding: 8px 16px; background: rgb(0,112,243); color: white; border: none;
             border-radius: 4px; cursor: pointer; font-size: 16px; }
    button:hover { background: rgb(0,81,179); }
    span { display: inline; }
    ul { padding-left: 24px; }
    pre { background: rgb(30,30,30); color: rgb(212,212,212); padding: 16px; border-radius: 4px;
          overflow-x: auto; font-family: monospace; }
    code { font-family: monospace; background: rgb(238,238,238); padding: 2px 4px; border-radius: 2px; }
    blockquote { border-left: 4px solid rgb(204,204,204); padding-left: 12px; color: rgb(85,85,85); }
    hr { border: none; border-top: 1px solid rgb(221,221,221); margin: 16px 0; }
    img, video { max-width: 100%; }
    .page { max-width: 800px; margin: 40px auto; padding: 24px; }
  </style>"
end

# Tiny JS: button clicks become form POSTs
def blimp_script() do
  "<script>
    function blimpSend(btn) {
      var msg = btn.getAttribute('data-sends');
      var form = document.createElement('form');
      form.method = 'POST';
      form.action = window.location.pathname;
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'msg';
      input.value = msg;
      form.appendChild(input);
      document.body.appendChild(form);
      form.submit();
    }
  </script>"
end

# -- Cookie / session helpers -----------------------------------------

# Find a header value from raw HTTP request
# e.g., find_header(raw, "Cookie:") -> "blimp_session=abc123; other=val"
def find_header(raw: String, header_name: String) -> String do
  lines = split(raw, "\r\n")
  find_header_line(lines, header_name)
end

def find_header_line(lines: List, header_name: String) -> String do
  case empty?(lines) do
    true -> ""
    _ ->
      line = head(lines)
      case contains(line, header_name) do
        true ->
          # Split on ": " to get the value part after "Header: value"
          parts = split(line, ": ")
          case length(parts) do
            1 -> ""
            _ -> head(tail(parts))
          end
        _ -> find_header_line(tail(lines), header_name)
      end
  end
end

# Parse blimp_session cookie value from raw HTTP request
# Returns session_id string or "" if no cookie
def parse_cookie(raw: String) -> String do
  cookie_header = find_header(raw, "Cookie:")
  case cookie_header do
    "" -> ""
    _ -> find_cookie_value(cookie_header, "blimp_session=")
  end
end

# Search cookie pairs for a specific cookie name
# Cookie header value looks like: "blimp_session=abc123; other=val"
def find_cookie_value(cookie_str: String, cookie_prefix: String) -> String do
  # Split on "; " (semicolon-space) to get individual cookies
  pairs = split(cookie_str, "; ")
  find_cookie_in_pairs(pairs, cookie_prefix)
end

def find_cookie_in_pairs(pairs: List, prefix: String) -> String do
  case empty?(pairs) do
    true -> ""
    _ ->
      pair = head(pairs)
      case contains(pair, prefix) do
        true ->
          # Split on "=" and take the value
          parts = split(pair, "=")
          case length(parts) do
            1 -> ""
            _ -> head(tail(parts))
          end
        _ -> find_cookie_in_pairs(tail(pairs), prefix)
      end
  end
end

# Generate a unique session token using random numbers and timestamp
# Format: "<random1>-<random2>-<timestamp>"
# Not cryptographically secure, but unique enough for a dev server
def generate_session_token() -> String do
  r1 = random(100000, 999999)
  r2 = random(100000, 999999)
  ts = now()
  concat(to_string(r1), concat("-", concat(to_string(r2), concat("-", to_string(ts)))))
end

# -- Session store ----------------------------------------------------

actor Sessions do
  state store: Map :: %{}

  on :new_session do
    id = generate_session_token()
    reply id
  end

  on :get(id: String) do
    reply lookup(store, id)
  end

  on :put(id: String, data: Map) do
    become store: put(store, id, data)
    reply :ok
  end
end

# -- App: Counter -----------------------------------------------------

# Initial state for a new session
def initial_state() do
  %{count: 0}
end

# Pure event handler: state x message -> new state
def handle_event(data: Map, msg: Atom) -> Map do
  case msg do
    :increment -> put(data, "count", lookup(data, "count") + 1)
    :decrement -> put(data, "count", lookup(data, "count") - 1)
    :reset     -> put(data, "count", 0)
    _          -> data
  end
end

# Pure render: state -> view_node
def render_app(data: Map) -> ViewNode do
  count = lookup(data, "count")
  stack(
    heading("Blimp Counter"),
    text(concat("Count: ", to_string(count))),
    row(
      button("- 1", :decrement),
      button("Reset", :reset),
      button("+ 1", :increment)
    )
  )
end

# -- Router -----------------------------------------------------------

# Parse "key=value&key2=value2", return value for key
def form_value(body: String, key: String) -> String do
  pairs = split(body, "&")
  find_pair(pairs, concat(key, "="))
end

def find_pair(pairs: List, prefix: String) -> String do
  case empty?(pairs) do
    true -> ""
    _    ->
      pair = head(pairs)
      case contains(pair, prefix) do
        true ->
          parts = split(pair, "=")
          head(tail(parts))
        _ ->
          find_pair(tail(pairs), prefix)
      end
  end
end

def last_elem(items: List) -> String do
  case empty?(items) do
    true -> ""
    _    ->
      case empty?(tail(items)) do
        true -> head(items)
        _    -> last_elem(tail(items))
      end
  end
end

def string_to_msg(s: String) -> Atom do
  case s do
    "increment" -> :increment
    "decrement" -> :decrement
    "reset"     -> :reset
    _           -> :unknown
  end
end

# -- Dispatcher -------------------------------------------------------

def dispatch(method: String, raw: String, session_id: String, data: Map, is_new: String) -> String do
  case method do
    "POST" ->
      lines = split(raw, "\r\n")
      body = last_elem(lines)
      msg_str = form_value(body, "msg")
      msg = string_to_msg(msg_str)
      new_data = handle_event(data, msg)
      Sessions <- :put(session_id, new_data)
      case is_new do
        "yes" -> http_redirect_with_cookie("/", session_id)
        _     -> http_redirect("/")
      end
    _ ->
      view = render_app(data)
      html = to_html(view)
      page = html_page("Counter", concat("<div class='page'>", concat(html, "</div>")))
      case is_new do
        "yes" -> http_ok_with_cookie(page, session_id)
        _     -> http_ok(page)
      end
  end
end

# -- HTTP Server actor ------------------------------------------------

actor HTTPServer do
  state port: Int :: 8080
  state fd: Int :: -1

  on :start do
    server_fd = tcp_listen(port)
    become fd: server_fd
    print(concat("Blimp HTTP server listening on http://localhost:", to_string(port)))
    HTTPServer <- :accept
  end

  on :accept do
    client_fd = tcp_accept(fd)
    raw = tcp_read(client_fd)

    first_line = head(split(raw, "\r\n"))
    req = parse_request_line(first_line)
    method = lookup(req, "method")

    # Cookie-based session identity
    cookie_session = parse_cookie(raw)
    session_id = case cookie_session do
      "" ->
        # No cookie — create a new session
        Sessions <- :new_session
      _ -> cookie_session
    end
    is_new = case cookie_session do
      "" -> "yes"
      _  -> "no"
    end

    existing = Sessions <- :get(session_id)
    data = existing orelse initial_state()

    # Store initial state for brand-new sessions
    case is_new do
      "yes" -> Sessions <- :put(session_id, data)
      _     -> :ok
    end

    response = dispatch(method, raw, session_id, data, is_new)

    tcp_write(client_fd, response)
    tcp_close(client_fd)

    HTTPServer <- :accept
  end
end

# -- Boot -------------------------------------------------------------

HTTPServer <- :start
