# Blimp HTTP Server
#
# A minimal HTTP/1.1 server written in Blimp.
# Boot:  blimp web/server.blimp
# Then:  open http://localhost:8080

# -- HTTP helpers -----------------------------------------------------

# Parse first line of HTTP request: "GET /path HTTP/1.1"
# Returns %{method: "GET", path: "/"}
def parse_request_line(raw) do
  parts = split(raw, " ")
  method = head(parts)
  path_part = head(tail(parts))
  path = split(path_part, "?") |> head
  %{method: method, path: path}
end

# Build an HTTP 200 response with HTML body
def http_ok(body) do
  len = length(body)
  concat(
    "HTTP/1.1 200 OK\r\n",
    concat("Content-Type: text/html; charset=utf-8\r\n",
    concat("Content-Length: ", concat(to_string(len),
    concat("\r\nConnection: close\r\n\r\n", body))))
  )
end

# Build an HTTP 302 redirect
def http_redirect(location) do
  concat(
    "HTTP/1.1 302 Found\r\n",
    concat("Location: ", concat(location,
    "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"))
  )
end

# Wrap rendered view in a full HTML page
def html_page(title, body_html) do
  concat(
    "<!DOCTYPE html><html><head><meta charset=utf-8>",
    concat("<title>", concat(title, concat("</title>",
    concat(html_styles(), concat("</head><body>",
    concat(body_html, concat(blimp_script(), "</body></html>")))))))
  )
end

def html_styles() do
  "<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: rgb(249,249,249); color: rgb(17,17,17); }
    div { display: flex; flex-direction: column; gap: 8px; padding: 8px; }
    div[data-row] { flex-direction: row; }
    h1,h2,h3,h4,h5,h6 { margin: 8px 0; }
    button { padding: 8px 16px; background: rgb(0,112,243); color: white; border: none;
             border-radius: 4px; cursor: pointer; font-size: 16px; }
    button:hover { background: rgb(0,81,179); }
    span { display: inline; }
    ul { padding-left: 24px; }
    pre { background: rgb(30,30,30); color: rgb(212,212,212); padding: 16px; border-radius: 4px;
          overflow-x: auto; font-family: monospace; }
    code { font-family: monospace; background: rgb(238,238,238); padding: 2px 4px; border-radius: 2px; }
    blockquote { border-left: 4px solid rgb(204,204,204); padding-left: 12px; color: rgb(85,85,85); }
    hr { border: none; border-top: 1px solid rgb(221,221,221); margin: 16px 0; }
    img, video { max-width: 100%; }
    .page { max-width: 800px; margin: 40px auto; padding: 24px; }
    div[data-actor] { border: 1px solid rgb(221,221,221); border-radius: 8px; padding: 16px; background: white; }
  </style>"
end

# JS: button clicks become form POSTs with actor routing
# Walks up the DOM to find the nearest data-actor boundary,
# so messages go to the right actor in a multi-actor page.
def blimp_script() do
  "<script>
    function blimpSend(btn) {
      var msg = btn.getAttribute('data-sends');
      var actor = '';
      var el = btn;
      while (el) {
        if (el.getAttribute && el.getAttribute('data-actor')) {
          actor = el.getAttribute('data-actor');
          break;
        }
        el = el.parentElement;
      }
      var form = document.createElement('form');
      form.method = 'POST';
      form.action = window.location.pathname;
      var msgInput = document.createElement('input');
      msgInput.type = 'hidden';
      msgInput.name = 'msg';
      msgInput.value = msg;
      form.appendChild(msgInput);
      var actorInput = document.createElement('input');
      actorInput.type = 'hidden';
      actorInput.name = 'actor';
      actorInput.value = actor;
      form.appendChild(actorInput);
      document.body.appendChild(form);
      form.submit();
    }
  </script>"
end

# -- Session store ----------------------------------------------------

actor Sessions do
  state store: Map :: %{}
  state next_id: Int :: 1

  on :new_session do
    id = to_string(next_id)
    become next_id: next_id + 1
    reply id
  end

  on :get(id: String) do
    reply lookup(store, id)
  end

  on :put(id: String, data: Map) do
    become store: put(store, id, data)
    reply :ok
  end
end

# -- View Composition -------------------------------------------------
#
# mount(actor_ref) sends :render to an actor and wraps the result
# in a mount boundary (div with data-actor attr). This lets
# buttons inside a mounted actor's view route messages back to
# that actor, not the parent.

def mount(actor_ref) do
  name = actor_name(actor_ref)
  view = actor_ref <- :render
  mount_root(name, view)
end

# -- Counter actor ----------------------------------------------------

actor Counter do
  state count: Int :: 0

  on :increment do
    become count: count + 1
  end

  on :decrement do
    become count: count - 1
  end

  on :reset do
    become count: 0
  end

  on :render do
    reply stack(
      heading("Counter", 2),
      text(concat("Count: ", to_string(count))),
      row(
        button("- 1", :decrement),
        button("Reset", :reset),
        button("+ 1", :increment)
      )
    )
  end
end

# -- Greeter actor ----------------------------------------------------

actor Greeter do
  state name: String :: "World"
  state excited: Int :: 0

  on :toggle_excitement do
    case excited do
      0 -> become excited: 1
      _ -> become excited: 0
    end
  end

  on :render do
    greeting = case excited do
      0 -> concat("Hello, ", concat(name, "."))
      _ -> concat("Hello, ", concat(name, "!!!"))
    end
    reply stack(
      heading("Greeter", 2),
      text(greeting),
      button("Toggle excitement", :toggle_excitement)
    )
  end
end

# -- Root page render (composes both actors) --------------------------

def render_app() do
  stack(
    heading("Blimp Multi-Actor Demo"),
    text("Two independent actors composed in one page:"),
    divider(),
    mount(Counter),
    divider(),
    mount(Greeter)
  )
end

# -- Router -----------------------------------------------------------

# Parse "key=value&key2=value2", return value for key
def form_value(body: String, key: String) -> String do
  pairs = split(body, "&")
  find_pair(pairs, concat(key, "="))
end

def find_pair(pairs: List, prefix: String) -> String do
  case empty?(pairs) do
    true -> ""
    _    ->
      pair = head(pairs)
      case contains(pair, prefix) do
        true ->
          parts = split(pair, "=")
          head(tail(parts))
        _ ->
          find_pair(tail(pairs), prefix)
      end
  end
end

def last_elem(items: List) -> String do
  case empty?(items) do
    true -> ""
    _    ->
      case empty?(tail(items)) do
        true -> head(items)
        _    -> last_elem(tail(items))
      end
  end
end

# Route a message to the Counter actor
def route_counter(msg_str: String) do
  case msg_str do
    "increment" -> Counter <- :increment
    "decrement" -> Counter <- :decrement
    "reset"     -> Counter <- :reset
    _           -> :unknown
  end
end

# Route a message to the Greeter actor
def route_greeter(msg_str: String) do
  case msg_str do
    "toggle_excitement" -> Greeter <- :toggle_excitement
    _                   -> :unknown
  end
end

# Route a message to the correct actor based on data-actor name
def route_message(target_actor: String, msg_str: String) do
  case target_actor do
    "Counter"  -> route_counter(msg_str)
    "Greeter"  -> route_greeter(msg_str)
    _          -> :unknown
  end
end

# -- Dispatcher -------------------------------------------------------

def dispatch(method: String, raw: String) -> String do
  case method do
    "POST" ->
      lines = split(raw, "\r\n")
      body = last_elem(lines)
      msg_str = form_value(body, "msg")
      target = form_value(body, "actor")
      route_message(target, msg_str)
      http_redirect("/")
    _ ->
      view = render_app()
      html = to_html(view)
      http_ok(html_page("Blimp App", concat("<div class='page'>", concat(html, "</div>"))))
  end
end

# -- HTTP Server actor ------------------------------------------------

actor HTTPServer do
  state port: Int :: 8080
  state fd: Int :: -1

  on :start do
    server_fd = tcp_listen(port)
    become fd: server_fd
    print(concat("Blimp HTTP server listening on http://localhost:", to_string(port)))
    HTTPServer <- :accept
  end

  on :accept do
    client_fd = tcp_accept(fd)
    raw = tcp_read(client_fd)

    first_line = head(split(raw, "\r\n"))
    req = parse_request_line(first_line)
    method = lookup(req, "method")

    # Actors manage their own state via become,
    # no session store needed for single-user mode
    response = dispatch(method, raw)

    tcp_write(client_fd, response)
    tcp_close(client_fd)

    HTTPServer <- :accept
  end
end

# -- Boot -------------------------------------------------------------

HTTPServer <- :start
