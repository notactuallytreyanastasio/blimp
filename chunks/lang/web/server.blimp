# Blimp HTTP Server
#
# A minimal HTTP/1.1 server written in Blimp.
# Actors handle routing and sessions. No Phoenix. No framework.
#
# Boot:  blimp web/server.blimp
# Then:  open http://localhost:8080

# ── HTTP helpers ─────────────────────────────────────────────

# Parse the first line of an HTTP request: "GET /path HTTP/1.1"
# Returns %{method: "GET", path: "/"}
def parse_request_line(raw) do
  parts = split(raw, " ")
  method = head(parts)
  path_part = head(tail(parts))
  path = split(path_part, "?") |> head
  %{method: method, path: path}
end

# Build an HTTP 200 response with HTML body
def http_ok(body) do
  len = length(body)
  concat(
    "HTTP/1.1 200 OK\r\n",
    concat("Content-Type: text/html; charset=utf-8\r\n",
    concat("Content-Length: ", concat(to_string(len),
    concat("\r\nConnection: close\r\n\r\n", body))))
  )
end

# Build an HTTP 302 redirect
def http_redirect(location) do
  concat(
    "HTTP/1.1 302 Found\r\n",
    concat("Location: ", concat(location, "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"))
  )
end

# Wrap a rendered view in a full HTML page with the Blimp client script
def html_page(title, body_html) do
  concat(
    "<!DOCTYPE html><html><head><meta charset=utf-8>",
    concat("<title>", concat(title, concat("</title>",
    concat(html_styles(), concat("</head><body>",
    concat(body_html, concat(blimp_script(), "</body></html>")))))))
  )
end

def html_styles() do
  "<style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #f9f9f9; color: #111; }
    div { display: flex; flex-direction: column; gap: 8px; padding: 8px; }
    div[data-row] { flex-direction: row; }
    h1,h2,h3,h4,h5,h6 { margin: 8px 0; }
    button { padding: 8px 16px; background: #0070f3; color: white; border: none;
             border-radius: 4px; cursor: pointer; font-size: 16px; }
    button:hover { background: #0051b3; }
    span { display: inline; }
    ul { padding-left: 24px; }
    pre { background: #1e1e1e; color: #d4d4d4; padding: 16px; border-radius: 4px;
          overflow-x: auto; font-family: monospace; }
    code { font-family: monospace; background: #eee; padding: 2px 4px; border-radius: 2px; }
    blockquote { border-left: 4px solid #ccc; padding-left: 12px; color: #555; }
    hr { border: none; border-top: 1px solid #ddd; margin: 16px 0; }
    img, video { max-width: 100%; }
    .page { max-width: 800px; margin: 40px auto; padding: 24px; }
  </style>"
end

# Tiny JS: sends button messages via form POST, no WebSocket yet
def blimp_script() do
  "<script>
    function blimpSend(btn) {
      var msg = btn.getAttribute('data-sends');
      var form = document.createElement('form');
      form.method = 'POST';
      form.action = window.location.pathname;
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'msg';
      input.value = msg;
      form.appendChild(input);
      document.body.appendChild(form);
      form.submit();
    }
  </script>"
end

# ── Session store (simple in-memory map actor) ───────────────

actor Sessions do
  state store: %{} :: %{}
  state next_id: Int :: 1

  on :new_session do
    id = to_string(next_id)
    become next_id: next_id + 1
    reply id
  end

  on :get(id) do
    reply lookup(store, id)
  end

  on :put(id, data) do
    become store: put(store, id, data)
    reply :ok
  end
end

# ── Router ────────────────────────────────────────────────────

# Dispatch a request to the right handler.
# Returns an HTTP response string.
def dispatch(method, path, session_id, session_data) do
  situation path do
    "/" ->
      situation method do
        "POST" ->
          # Receive button event: advance session state based on msg param
          # (POST body not parsed yet, stub: always :increment)
          new_data = handle_event(session_data, :increment)
          Sessions <- :put(session_id, new_data)
          http_redirect("/")
        _ ->
          # GET — render view
          view = render_app(session_data)
          html = to_html(view)
          http_ok(html_page("Counter", concat("<div class='page'>", concat(html, "</div>"))))
      end
    _ ->
      http_ok("<h1>404 Not Found</h1>")
  end
end

# ── App: Counter ──────────────────────────────────────────────

# Initial state for a new session
def initial_state() do
  %{count: 0}
end

# Pure event handler: given session data and a message atom, return new data
def handle_event(data, msg) do
  situation msg do
    :increment -> put(data, "count", lookup(data, "count") + 1)
    :decrement -> put(data, "count", lookup(data, "count") - 1)
    :reset     -> put(data, "count", 0)
    _          -> data
  end
end

# Pure render: given session data, return a view_node tree
def render_app(data) do
  count = lookup(data, "count")
  stack(
    heading("Blimp Counter"),
    text(concat("Count: ", to_string(count))),
    row(
      button("- 1", :decrement),
      button("Reset", :reset),
      button("+ 1", :increment)
    )
  )
end

# ── Server loop ───────────────────────────────────────────────

actor HTTP.Server do
  state port: Int :: 8080
  state fd: Int :: -1

  on :start do
    server_fd = tcp_listen(port)
    become fd: server_fd
    print(concat("Blimp HTTP server listening on http://localhost:", to_string(port)))
    HTTP.Server <- :accept
  end

  on :accept do
    client_fd = tcp_accept(fd)
    raw = tcp_read(client_fd)

    # Parse first line of HTTP request
    first_line = head(split(raw, "\r\n"))
    req = parse_request_line(first_line)
    method = lookup(req, "method")
    path = lookup(req, "path")

    # Session: read cookie or assign new id (simplified: use header)
    # For now, everyone gets the same session "1" until cookie parsing is added
    session_id = "1"
    existing = Sessions <- :get(session_id)
    session_data = existing orelse initial_state()

    # If POST, extract msg from body (last line of request)
    data = situation method do
      "POST" ->
        lines = split(raw, "\r\n")
        body = last_line(lines)
        msg = parse_form_value(body, "msg")
        new_data = handle_event(session_data, to_atom(msg))
        Sessions <- :put(session_id, new_data)
        new_data
      _ ->
        session_data
    end

    response = situation method do
      "POST" -> http_redirect("/")
      _ ->
        view = render_app(data)
        html = to_html(view)
        http_ok(html_page("Counter", concat("<div class='page'>", concat(html, "</div>"))))
    end

    tcp_write(client_fd, response)
    tcp_close(client_fd)

    # Loop
    HTTP.Server <- :accept
  end
end

# ── Helpers for body parsing ──────────────────────────────────

# Get last element of a list
def last_line(lines) do
  situation empty?(lines) do
    true -> ""
    _ ->
      situation empty?(tail(lines)) do
        true -> head(lines)
        _    -> last_line(tail(lines))
      end
  end
end

# Parse "key=value&key2=value2", return value for given key
def parse_form_value(body, key) do
  pairs = split(body, "&")
  find_value(pairs, concat(key, "="))
end

def find_value(pairs, prefix) do
  situation empty?(pairs) do
    true -> ""
    _ ->
      pair = head(pairs)
      situation contains(pair, prefix) do
        true ->
          parts = split(pair, "=")
          head(tail(parts))
        _ ->
          find_value(tail(pairs), prefix)
      end
  end
end

# Convert a string to an atom (strips whitespace)
def to_atom(s) do
  situation s do
    "increment" -> :increment
    "decrement" -> :decrement
    "reset"     -> :reset
    _           -> :unknown
  end
end

# ── Boot ─────────────────────────────────────────────────────

HTTP.Server <- :start
