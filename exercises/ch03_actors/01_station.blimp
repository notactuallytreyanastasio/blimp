# Chapter 3 -- Actors talking to actors
# Run: blimp exercises/ch03_actors/01_station.blimp --test
#
# A second actor enters the picture. The Bike still owns its own
# status. The DockingStation owns a list of bikes that are physically
# parked here right now. Renting a bike pulls it off the station's
# list and tells the bike itself to flip status.
#
# Three handler bodies are stubbed with :TODO. Fill them in.

actor Bike do
  state id: String :: "unknown"
  state status: Atom :: :available

  on :id do
    reply id
  end

  on :status do
    reply status
  end

  on :rent when status == :available do
    become status: :rented
    reply :ok
  end

  on :rent do
    reply {:error, :unavailable}
  end
end

actor DockingStation do
  state name: String :: "unnamed"
  state bikes: [Bike] :: []

  on :name do
    reply name
  end

  on :count do
    reply length(bikes)
  end

  # --- :dock --------------------------------------------------------

  on :dock(b: Bike) do
    # Exercise: prepend b onto the bikes list, reply :ok
    reply :TODO
  end

  # --- :rent --------------------------------------------------------
  # Two clauses again. The guarded one runs when the station has at
  # least one bike. The fallback runs when the list is empty.

  on :rent when length(bikes) > 0 do
    # Exercise: pull the first bike off the list with head(bikes),
    # set the new list to tail(bikes), send :rent to that bike,
    # then reply {:ok, that_bike_id}.
    reply :TODO
  end

  on :rent do
    # Exercise: reply {:error, :empty}
    reply :TODO
  end
end

actor StationTests do
  state st: DockingStation :: spawn DockingStation, name: "fulton"

  test "name reports the spawn-time name" do
    assert_eq(st <- :name, "fulton")
  end

  test "starts with zero bikes" do
    assert_eq(st <- :count, 0)
  end

  test "dock replies :ok" do
    a = spawn Bike
    assert_eq(st <- :dock(a), :ok)
  end

  test "dock increments count" do
    a = spawn Bike
    st <- :dock(a)
    assert_eq(st <- :count, 1)
  end

  test "rent on empty station returns {:error, :empty}" do
    assert_eq(st <- :rent, {:error, :empty})
  end

  test "rent returns {:ok, bike_id}" do
    a = spawn Bike, id: "b-01"
    st <- :dock(a)
    assert_eq(st <- :rent, {:ok, "b-01"})
  end

  test "rent removes the bike from the station" do
    a = spawn Bike
    st <- :dock(a)
    st <- :rent
    assert_eq(st <- :count, 0)
  end

  test "rent flips the bike's own status to :rented" do
    a = spawn Bike, id: "b-77"
    st <- :dock(a)
    st <- :rent
    assert_eq(a <- :status, :rented)
  end
end
