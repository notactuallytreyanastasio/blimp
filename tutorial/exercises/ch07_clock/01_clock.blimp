# Chapter 7 -- The Clock
# Run: blimp exercises/ch07_clock/01_clock.blimp --test
#
# A Clock actor with a single Int field that callers advance with
# :tick. The Rider from Chapter 6 grows a pickup_at field that
# captures the clock's current value at pickup time, and an
# :elapsed handler that reports how long the rider has had the
# bike.
#
# Three TODO handlers; the multi-clause :pickup, :return, and
# :elapsed get their fallback clauses pre-wired.

actor Bike do
  state id: String :: "unknown"
  state status: Atom :: :available

  on :id do
    reply id
  end

  on :status do
    reply status
  end

  on :rent when status == :available do
    become status: :rented
    reply :ok
  end

  on :rent do
    reply {:error, :unavailable}
  end

  on :return do
    become status: :available
    reply :ok
  end
end

actor Clock do
  state tick: Int :: 0

  on :now do
    reply tick
  end

  # --- :tick --------------------------------------------------------
  # Advance the clock by one and reply with the new value.

  on :tick do
    # Exercise: become tick: tick + 1, then reply with the new value
    # (which is tick + 1, since `tick` inside the handler still holds
    # the pre-become value).
    reply :TODO
  end
end

actor BikeShare.Rider do
  state name: String :: "anon"
  state bike: Bike :: nil
  state pickup_at: Int :: 0

  on :name do
    reply name
  end

  on :status do
    case bike == nil do
      true -> reply :idle
      _ -> reply :riding
    end
  end

  # --- :pickup ------------------------------------------------------
  # Same shape as Chapter 6, with one more move on the success
  # branch: ask the clock for `:now` and stash it in pickup_at so
  # we can compute elapsed time later.

  on :pickup(b: Bike, clock: Clock) when bike == nil do
    # Exercise: send :rent to b, bind the reply, case on it. On :ok,
    # become bike: b *and* pickup_at: (clock <- :now), then reply :ok.
    # On anything else, reply {:error, :unavailable} without touching
    # state.
    reply :TODO
  end

  on :pickup(b: Bike, clock: Clock) do
    reply {:error, :already_riding}
  end

  on :return when bike != nil do
    bike <- :return
    become bike: nil, pickup_at: 0
    reply :ok
  end

  on :return do
    reply {:error, :no_bike}
  end

  # --- :elapsed -----------------------------------------------------
  # When holding a bike, return the difference between the clock's
  # current value and the pickup_at we recorded at pickup.

  on :elapsed(clock: Clock) when bike != nil do
    # Exercise: reply with (clock <- :now) - pickup_at.
    reply :TODO
  end

  on :elapsed(clock: Clock) do
    reply 0
  end
end

actor ClockTests do
  test "clock starts at 0" do
    c = spawn Clock
    assert_eq(c <- :now, 0)
  end

  test "tick advances and returns the new value" do
    c = spawn Clock
    assert_eq(c <- :tick, 1)
    assert_eq(c <- :tick, 2)
    assert_eq(c <- :now, 2)
  end

  test "fresh rider's elapsed is 0" do
    c = spawn Clock
    r = spawn BikeShare.Rider
    assert_eq(r <- :elapsed(c), 0)
  end

  test "elapsed right after pickup is 0" do
    c = spawn Clock
    r = spawn BikeShare.Rider
    b = spawn Bike
    r <- :pickup(b, c)
    assert_eq(r <- :elapsed(c), 0)
  end

  test "elapsed after pickup and three ticks is 3" do
    c = spawn Clock
    r = spawn BikeShare.Rider
    b = spawn Bike
    r <- :pickup(b, c)
    c <- :tick
    c <- :tick
    c <- :tick
    assert_eq(r <- :elapsed(c), 3)
  end

  test "pickup after some ticks captures the right starting time" do
    c = spawn Clock
    c <- :tick
    c <- :tick
    r = spawn BikeShare.Rider
    b = spawn Bike
    r <- :pickup(b, c)
    c <- :tick
    assert_eq(r <- :elapsed(c), 1)
  end

  test "return clears pickup_at" do
    c = spawn Clock
    r = spawn BikeShare.Rider
    b = spawn Bike
    r <- :pickup(b, c)
    c <- :tick
    c <- :tick
    r <- :return
    assert_eq(r <- :elapsed(c), 0)
  end
end
