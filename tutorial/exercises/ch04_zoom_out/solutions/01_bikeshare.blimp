# Chapter 4 -- Solution
# Reference implementation. Don't peek until you've tried the stub.

actor Station do
  state name: String :: "unnamed"
  state count: Int :: 0

  on :name do
    reply name
  end

  on :count do
    reply count
  end

  on :add_bike do
    become count: count + 1
    reply :ok
  end
end

actor BikeShare do
  state name: String :: "default"
  state stations: [Station] :: []

  on :name do
    reply name
  end

  on :station_count do
    reply length(stations)
  end

  on :open(s: Station) do
    become stations: [s | stations]
    reply :ok
  end

  on :total_bikes do
    counts = map(stations, fn(s: Station) do s <- :count end)
    reply reduce(counts, 0, fn(acc: Int, n: Int) do acc + n end)
  end

  on :busy_stations do
    busy = filter(stations, fn(s: Station) do (s <- :count) > 0 end)
    reply map(busy, fn(s: Station) do s <- :name end)
  end
end

actor BikeShareTests do
  state share: BikeShare :: spawn BikeShare, name: "brooklyn"

  test "name reports the spawn-time name" do
    assert_eq(share <- :name, "brooklyn")
  end

  test "starts with zero stations" do
    assert_eq(share <- :station_count, 0)
  end

  test "open replies :ok" do
    s = spawn Station, name: "fulton"
    assert_eq(share <- :open(s), :ok)
  end

  test "open registers the station" do
    s = spawn Station, name: "fulton"
    share <- :open(s)
    assert_eq(share <- :station_count, 1)
  end

  test "total_bikes is 0 when empty" do
    assert_eq(share <- :total_bikes, 0)
  end

  test "total_bikes sums across stations" do
    s1 = spawn Station, name: "fulton"
    s2 = spawn Station, name: "atlantic"
    share <- :open(s1)
    share <- :open(s2)
    s1 <- :add_bike
    s1 <- :add_bike
    s2 <- :add_bike
    assert_eq(share <- :total_bikes, 3)
  end

  test "busy_stations names only the non-empty ones" do
    s1 = spawn Station, name: "fulton"
    s2 = spawn Station, name: "atlantic"
    share <- :open(s1)
    share <- :open(s2)
    s1 <- :add_bike
    assert_eq(share <- :busy_stations, ["fulton"])
  end
end
