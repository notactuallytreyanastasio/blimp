# Chapter 6 -- The Rider
# Run: blimp exercises/ch06_rider/01_rider.blimp --test
#
# A BikeShare.Rider holds a single user's session: their name and
# the bike they currently have out (or nil if they're idle).
#
# Three TODO handlers; the multi-clause :pickup and :return get
# their fallback clauses pre-wired so you can focus on the guarded
# clauses that do the new work.

actor Bike do
  state id: String :: "unknown"
  state status: Atom :: :available

  on :id do
    reply id
  end

  on :status do
    reply status
  end

  on :rent when status == :available do
    become status: :rented
    reply :ok
  end

  on :rent do
    reply {:error, :unavailable}
  end

  on :return do
    become status: :available
    reply :ok
  end
end

actor BikeShare.Rider do
  state name: String :: "anon"
  state bike: Bike :: nil

  on :name do
    reply name
  end

  # --- :status ------------------------------------------------------
  # Reply :idle when there's no bike, :riding otherwise.

  on :status do
    # Exercise: case on whether `bike` is nil. Reply :idle when it
    # is, :riding when it isn't.
    reply :TODO
  end

  # --- :pickup ------------------------------------------------------
  # Two clauses. The guarded one runs when the rider has no bike yet:
  # try to rent the offered bike; if the bike accepts, store the
  # reference and reply :ok; if the bike refuses, reply with the
  # error tuple. The fallback runs when the rider already has a bike.

  on :pickup(b: Bike) when bike == nil do
    # Exercise: send :rent to b and bind the reply to a local. Case
    # on it. On :ok, become bike: b and reply :ok. On anything else,
    # reply {:error, :unavailable} without touching state.
    reply :TODO
  end

  on :pickup(b: Bike) do
    reply {:error, :already_riding}
  end

  # --- :return ------------------------------------------------------
  # Two clauses. The guarded one runs when the rider is holding a
  # bike: tell the bike to return, clear the slot, reply :ok. The
  # fallback runs when the rider is already idle.

  on :return when bike != nil do
    # Exercise: send :return to the held bike, become bike: nil to
    # clear the slot, reply :ok. Send before the become so the
    # reference is still in scope when you use it.
    reply :TODO
  end

  on :return do
    reply {:error, :no_bike}
  end
end

actor RiderTests do
  test "fresh rider is idle" do
    r = spawn BikeShare.Rider, name: "alice"
    assert_eq(r <- :status, :idle)
  end

  test "pickup an available bike returns :ok" do
    r = spawn BikeShare.Rider
    b = spawn Bike, id: "b-01"
    assert_eq(r <- :pickup(b), :ok)
  end

  test "after pickup, rider is :riding" do
    r = spawn BikeShare.Rider
    b = spawn Bike
    r <- :pickup(b)
    assert_eq(r <- :status, :riding)
  end

  test "pickup while already riding refuses" do
    r = spawn BikeShare.Rider
    b1 = spawn Bike
    b2 = spawn Bike
    r <- :pickup(b1)
    assert_eq(r <- :pickup(b2), {:error, :already_riding})
  end

  test "pickup of an already-rented bike returns :unavailable" do
    r = spawn BikeShare.Rider
    b = spawn Bike
    b <- :rent
    assert_eq(r <- :pickup(b), {:error, :unavailable})
  end

  test "return frees the bike" do
    r = spawn BikeShare.Rider
    b = spawn Bike
    r <- :pickup(b)
    r <- :return
    assert_eq(b <- :status, :available)
  end

  test "return when idle returns :no_bike" do
    r = spawn BikeShare.Rider
    assert_eq(r <- :return, {:error, :no_bike})
  end
end
